# --- YouTube Extraction ---
# YouTube restricts server-side extraction through three independent gates:
# 1. Anti-bot gate (cookies)
# 2. Proof of Origin token (PO Token)
# 3. Signature cipher / n-challenge (JavaScript runtime)

# 1. Anti-bot gate — Browser cookies.
# On Windows, only Firefox can be read directly (Chrome/Edge/Brave DPAPI-encrypted cookies cannot be decrypted by yt-dlp).
# Alternatively, export cookies in Netscape format to a text file.
UNSTREAM_COOKIES_BROWSER=firefox
# UNSTREAM_COOKIES_FILE=C:\path\to\cookies.txt

# 2. PO Token (Proof of Origin)
# Two modes supported (HTTP takes precedence if both configured):
# A) Persistent HTTP Server (Recommended — runs as background container, avoids Node process spawn per token):
#    docker run -d --name unstream-potoken --restart unless-stopped \
#      -p 4416:4416 brainicism/bgutil-ytdlp-pot-provider:1.3.1
# UNSTREAM_POT_BASE_URL=http://localhost:4416
# B) Local Script Mode — build via `bash server/setup_potoken.sh` (auto-detected):
# UNSTREAM_POT_SERVER_HOME=C:\path\to\bgutil-ytdlp-pot-provider\server

# 3. Signature cipher / n-challenge solver
# Requires yt-dlp-ejs (in requirements.txt) and a JS runtime.
# Auto-detects deno, bun, or node.
# UNSTREAM_JS_RUNTIME=node

# --- Proxy Configuration ---
# Route external traffic through a proxy (yt-dlp, catalogs, lyrics, cover art).
# Use socks5h:// to resolve DNS remotely on restricted networks.
# UNSTREAM_PROXY=socks5h://127.0.0.1:1080
# UNSTREAM_PROXY=http://user:pass@127.0.0.1:8080

# Dedicated proxy for audio extraction only (when catalogs are directly accessible):
# UNSTREAM_YTDLP_PROXY=socks5h://127.0.0.1:1080

# Dedicated proxy for Telegram bot (defaults to UNSTREAM_PROXY):
# UNSTREAM_TELEGRAM_PROXY=socks5h://127.0.0.1:1080

# --- Archive Output Layout ---
# Directory structure inside generated ZIP downloads. Placeholders:
# {albumartist} {artist} {album} {title} {track} {disc} {year} {genre}
# Missing metadata fields cleanly omit their section to avoid blank folders.
# UNSTREAM_PATH_TEMPLATE={albumartist}/{album}/{track} - {title}
# UNSTREAM_PATH_TEMPLATE={artist}/{year} - {album}/{track}. {title}
# Generate .m3u playlist in archive when multiple tracks are downloaded (1=enabled, 0=disabled)
# UNSTREAM_M3U=1

# --- Spotify (Optional) ---
# Enables exact Spotify track, album, and playlist resolution via official API.
# Free credentials: https://developer.spotify.com/dashboard
# UNSTREAM_SPOTIFY_CLIENT_ID=
# UNSTREAM_SPOTIFY_CLIENT_SECRET=

# --- Genius Lyrics (Optional) ---
# Secondary lyrics provider when LRCLIB (keyless synced lyrics) yields no match.
# Free token: https://genius.com/api-clients
# UNSTREAM_GENIUS_ACCESS_TOKEN=

# --- AI Vibe Chatbot (Optional) ---
# Natural language playlist recommendation based on mood via Google Gemini.
# Free key: https://aistudio.google.com/apikey
# UNSTREAM_GEMINI_API_KEY=
# UNSTREAM_GEMINI_MODEL=gemini-2.5-flash

# --- Telegram Bot (Optional) ---
# Standalone bot to search, resolve, and download tracks via Telegram chats.
# Free token: https://t.me/BotFather -> /newbot
# UNSTREAM_TELEGRAM_BOT_TOKEN=
# Base API URL when bot runs as a separate process or container:
# UNSTREAM_API_BASE_URL=http://localhost:8000

# Artist follow database path (defaults to data/ directory):
# UNSTREAM_BOT_DB=C:\path\to\bot.db
# Poll interval for newly released music (seconds, default: 1800 = 30 min):
# UNSTREAM_FOLLOW_POLL_INTERVAL=1800

# Inline Mode (@botname track_name): Enable in @BotFather via /setinline.
# To return playable audio files directly in inline mode, specify a private channel ID where the bot is admin:
# UNSTREAM_TELEGRAM_CACHE_CHAT_ID=-1001234567890

# WebApp URL for Telegram Mini App button (must be HTTPS):
# UNSTREAM_TELEGRAM_WEBAPP_URL=https://your-domain.example.com

# --- Mood Audio Analysis ---
# Valence and energy acoustic analysis via librosa on each download.
# Powers mood-coherent smart shuffling. Set to 0 to disable and save CPU.
# UNSTREAM_MOOD=0

# --- Loudness Normalization ---
# Measures perceptual loudness (EBU R128 LUFS) and true peak using ffmpeg.
# Stored as metadata and normalized on the fly during playback via Web Audio API.
# UNSTREAM_LOUDNESS=0
# Target loudness in LUFS (-14 LUFS is the standard across Spotify and YouTube):
# UNSTREAM_LOUDNESS_TARGET=-14

# --- Audio Identification ---
# 1. AcoustID (Free) — Full file identification using Chromaprint fingerprints.
#    Application key: https://acoustid.org/new-application
#    Requires fpcalc in PATH or specified via UNSTREAM_FPCALC:
# UNSTREAM_ACOUSTID_KEY=
# UNSTREAM_FPCALC=C:\tools\chromaprint\fpcalc.exe

# 2. AudD (Optional) — Short snippet and microphone recording identification (Shazam-like).
#    https://dashboard.audd.io
# UNSTREAM_AUDD_TOKEN=

# --- General Server Settings ---
# Audio extraction providers priority order (soundcloud,youtube or youtube,soundcloud):
# UNSTREAM_AUDIO_SOURCES=soundcloud,youtube
# UNSTREAM_DOWNLOAD_DIR=C:\Music\Unstream
# Max concurrent downloads (default: 3):
# UNSTREAM_CONCURRENCY=3
# Job retention in seconds (default: 3600):
# UNSTREAM_JOB_TTL=3600
# Path to ffmpeg binary directory if not in system PATH:
# UNSTREAM_FFMPEG=C:\ffmpeg\bin

# --- Intranet / Network Outage Resilience ---
# Automatic resilience for constrained or disconnected networks.
# Cache album art locally on server disk:
# UNSTREAM_ART_MIRROR=1
# Cache catalog search and entity pages:
# UNSTREAM_CATALOG_CACHE=1
# Defer failed downloads during outages and auto-resume on connectivity restoration:
# UNSTREAM_DEFER_DOWNLOADS=1
# Health reachability probe endpoints (comma-separated):
# UNSTREAM_REACH_PROBES=https://cloudflare.com/cdn-cgi/trace,https://www.gstatic.com/generate_204,https://1.1.1.1/cdn-cgi/trace
# Probe timeout in seconds:
# UNSTREAM_REACH_TIMEOUT=6
# Consecutive probe failures required before entering intranet offline mode:
# UNSTREAM_REACH_STRIKES=2
# Probe interval when online (seconds):
# UNSTREAM_REACH_INTERVAL=120
# Probe interval when offline (seconds):
# UNSTREAM_REACH_RETRY_INTERVAL=30
# Pre-fetch pending cover art in the background:
# UNSTREAM_ART_WARM=1
