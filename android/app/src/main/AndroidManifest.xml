<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      بکاپِ خودکار خاموش.

      پیش‌فرضِ `true` یعنی «از همه‌چیزِ پوشه‌ی خصوصیِ اپ نسخه‌ی ابری بساز».
      آن‌جا آدرسِ سرورِ شخصی، کوکیِ لاگینِ سرویس‌های موسیقی و تنظیماتِ کاربر
      نشسته است — هیچ‌کدام نباید روی فضای ابریِ شخصِ ثالث برود.

      مسیرِ exclude هم جواب نبود: `cache` دامنه‌ی مجازِ backup_rules نیست و
      `path="."` را AAPT رد می‌کند (lintVital روی release می‌شکند). برای اپی که
      همه‌ی داده‌اش روی سرورِ خودِ کاربر است و فایل‌های دانلودی هم در MediaStore
     ‌اند (جای بکاپ‌شدنیِ خودِ اندروید)، صفر کردن ساده‌ترین و درست‌ترین تصمیم است.
    -->
    <application
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              «اشتراک‌گذاری» از هر اپ دیگری (تلگرام، مرورگر، اسپاتیفای) به موزیک بازی.
              لینکِ آلبوم یا ترک را می‌گیرد و همان لحظه بازش می‌کند — بدون این،
              کاربر باید لینک را کپی می‌کرد، اپ را باز می‌کرد و پیست می‌کرد.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- میان‌بُرهایِ لانچر: انگشت‌فشردِ آیکون → جستجو / ادامه / لایک‌ها -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!--
          سرویسِ پخش. `mediaPlayback` از اندروید ۱۴ اجباری است: بدونش سیستم
          هنگامِ `startForeground` استثنا پرت می‌کند و اپ می‌ترکد.
        -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- Native Audiophile Playback Service (Media3 MediaSession) -->
        <service
            android:name=".audio.service.NativePlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- دکمه‌های رسانه‌ایِ هدفون و بلوتوث را به سرویسِ بالا می‌رساند -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- ویجت هوم‌اسکرین اندروید -->
        <receiver
            android:name=".PlaybackWidget"
            android:exported="true"
            android:label="@string/widget_playback_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_playback_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- پخش پس‌زمینه: سرویسِ پیش‌زمینه + نوعش (اندروید ۱۴ به بعد جدا می‌خواهد) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- تا با خاموش‌شدنِ صفحه، پردازنده وسطِ آهنگ نخوابد -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- اندروید ۱۳ به بعد: بدونش نوتیفیکیشنِ پخش اصلاً نشان داده نمی‌شود -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- لرزشِ ریزِ بازخوردِ لمسی -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ضبط صدا برای قابلیت شناسایی آهنگ با میکروفون -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      ذخیره‌ی آهنگ در کتابخانه‌ی موسیقیِ گوشی. از اندروید ۱۰ اپ برای نوشتن در
      کالکشنِ خودش هیچ اجازه‌ای نمی‌خواهد، پس این فقط برای گوشی‌های قدیمی‌تر
      اعلام می‌شود — بدونِ `maxSdkVersion` هر کاربری هنگام نصب یک درخواستِ
      دسترسیِ ترسناکِ بی‌مورد می‌دید.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
</manifest>
