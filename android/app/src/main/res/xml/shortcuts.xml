<?xml version="1.0" encoding="utf-8"?>
<!--
  میان‌بُرهایِ لانچر (انگشت‌فشردِ آیکون اپ، و در لانچرهای پشتیبان‌کننده، جستجو).

  چرا این سه؟ چون سه نیتِ متفاوت‌اند، نه سه صفحه: «پیدا کن»، «ادامه بده»،
  «لایک‌ها». هر سه با یک ضربه به مقصد می‌رسند و هیچ‌کدام مسیرِ ناوبریِ داخلِ اپ
  را دور نمی‌زنند — اینتنت فقط یک `route` می‌آورد و خودِ وب‌اپ با همان
  `?q=`/`?library=` که ناوبری داخلی می‌شناسد، می‌رودش.

  `shortcutId` برای آمار لازم است؛ بدون آن معلوم نمی‌شود کدام میان‌بُر واقعاً
  استفاده می‌شود (و اگر هیچ‌کدام نشد، حذفشان ارزان‌تر از نگه‌داشتن است).
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.musicbazi.client"
            android:targetClass="app.musicbazi.client.MainActivity">
            <extra android:name="musicbazi.route" android:value="search" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="resume"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_play"
        android:shortcutShortLabel="@string/shortcut_resume_short"
        android:shortcutLongLabel="@string/shortcut_resume_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.musicbazi.client"
            android:targetClass="app.musicbazi.client.MainActivity">
            <extra android:name="musicbazi.route" android:value="resume" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="liked"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_heart"
        android:shortcutShortLabel="@string/shortcut_liked_short"
        android:shortcutLongLabel="@string/shortcut_liked_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.musicbazi.client"
            android:targetClass="app.musicbazi.client.MainActivity">
            <extra android:name="musicbazi.route" android:value="liked" />
        </intent>
    </shortcut>

</shortcuts>
