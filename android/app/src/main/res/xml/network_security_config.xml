<?xml version="1.0" encoding="utf-8"?>
<!--
  اندروید ۹ به بعد ترافیک رمزنشده را پیش‌فرض می‌بندد.

  سرور موزیک بازی معمولاً روی شبکه‌ی خانه و روی http ساده بالا می‌آید
  (http://192.168.x.x:8080). بدون این فایل، اپ نصب می‌شود، باز می‌شود، و بعد
  هر درخواستی *بی‌صدا* شکست می‌خورد — بدون هیچ پیام قابل‌فهمی برای کاربر.

  چرا برای همه‌ی دامنه‌ها و نه فقط یک آی‌پی: آدرس سرور را کاربر در خودِ اپ
  وارد می‌کند و ممکن است فردا عوض شود (آی‌پیِ DHCP، آدرس تونل، لپ‌تاپ دیگر).
  سفت‌کردنِ یک آی‌پی اینجا یعنی هر بار تغییرِ آدرس، یک APK جدید.

  ریسکش محدود است: اپ فقط به آدرسی می‌رود که خودِ کاربر داده، و trust anchor
  پیش‌فرض دست‌نخورده مانده — یعنی هر آدرس https همچنان با گواهیِ معتبر
  بررسی می‌شود.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
