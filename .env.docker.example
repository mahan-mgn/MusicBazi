# Copy this file to `.env` in the project root; docker compose reads it automatically.
# All values are optional — the stack starts with sensible defaults without any configuration.

# --- Docker Host Ports (Optional) ---
# Web UI port exposed on the host (Frontend / Nginx)
MUSICBAZI_WEB_PORT=8080
# Direct FastAPI backend port exposed on the host (API / Swagger UI)
MUSICBAZI_SERVER_PORT=8000
# YouTube PO Token provider port exposed on the host
MUSICBAZI_POT_PORT=4416


# --- YouTube Cookies ---
# Cookies cannot be extracted directly from a browser inside a container.
# Export cookies in Netscape format (e.g. via the "Get cookies.txt" browser extension),
# save to `secrets/cookies.txt`, and uncomment the line below:
# MUSICBAZI_COOKIES_FILE=/secrets/cookies.txt

# --- Spotify (Optional) ---
# Without credentials, Spotify track/album URLs are resolved via public oEmbed title heuristics (playlists unsupported).
# With free credentials, Spotify tracks, albums, and playlists are parsed with exact metadata:
# https://developer.spotify.com/dashboard
# MUSICBAZI_SPOTIFY_CLIENT_ID=
# MUSICBAZI_SPOTIFY_CLIENT_SECRET=

# --- Genius Lyrics (Optional) ---
# Fallback lyrics provider when LRCLIB (keyless, priority 1, synchronized .lrc) yields no results.
# Genius provides plain text lyrics only (non-synced).
# Free token: https://genius.com/api-clients
# MUSICBAZI_GENIUS_ACCESS_TOKEN=

# --- AcoustID Fingerprinting (Optional) ---
# Validates audio fingerprints of downloaded files and enables full-file acoustic identification.
# Chromaprint fpcalc binary is pre-installed in the Docker image.
# Application key: https://acoustid.org/new-application
# MUSICBAZI_ACOUSTID_KEY=

# --- AudD Recognition (Optional) ---
# Enables "Shazam-like" microphone recording and short audio snippet identification.
# Without this token, no audio recordings leave the server.
# https://dashboard.audd.io
# MUSICBAZI_AUDD_TOKEN=

# --- Loudness Normalization (Optional) ---
# Enabled by default. Measures perceptual loudness (EBU R128 LUFS) and true peak on download using ffmpeg.
# Stored as metadata and applied during playback via Web Audio API. Original files remain untouched.
# MUSICBAZI_LOUDNESS=0
# MUSICBAZI_LOUDNESS_TARGET=-14

# --- Proxy (Optional) ---
# Applies to all outbound requests: yt-dlp, catalog APIs, lyrics, and cover art downloads.
# In Docker, 127.0.0.1 refers to the container itself — use host.docker.internal for host proxies.
# MUSICBAZI_PROXY=socks5h://host.docker.internal:1080

# --- AI Vibe Chatbot (Optional) ---
# Natural language playlist generation based on mood and feelings via Gemini.
# Without a key, falls back to keyword mapping.
# Free key: https://aistudio.google.com/apikey
# MUSICBAZI_GEMINI_API_KEY=

# --- Telegram Bot (Optional) ---
# Download tracks/albums via Telegram chat. Token from @BotFather -> /newbot.
# Enable via `docker compose --profile bot up`.
# MUSICBAZI_TELEGRAM_BOT_TOKEN=

# Artist follow check interval (in seconds, default: 1800 = 30 min)
# MUSICBAZI_FOLLOW_POLL_INTERVAL=1800
